    <Assign sap2010:Annotation.AnnotationText="// 1위 데이터를 HTML 테이블 형식의 문자열로 변환하여 out_topRankData 변수에 저장합니다.&#xA;&#xA;in_topRankDataTable은 1위 데이터를 담고 있는 데이터 테이블입니다.&#xA;AsEnumerable 메서드를 사용하여 테이블의 각 행을 순회합니다.&#xA;Select 메서드는 각 행을 HTML 테이블 행 형식의 문자열로 변환합니다.&#xA;String.Format 메서드는 HTML 형식의 문자열에 각 열의 데이터를 삽입합니다.&#xA;변환된 각 행은 문자열 배열로 변환된 후 String.Join 메서드를 통해 하나의 문자열로 합쳐집니다.&#xA;결과 문자열은 out_topRankData 변수에 저장됩니다.&#xA;&#xA;// in_topRankDataTable의 각 행을 순회하며 HTML 테이블 행 형식으로 변환합니다.&#xA;out_topRankData = String.Join(&quot;&quot;, in_topRankDataTable.AsEnumerable().Select(Function(row) &#xA;    // 각 행의 데이터를 HTML 테이블 행으로 변환합니다.&#xA;    String.Format(&quot;&lt;tr&gt;&#xA;        &lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&#xA;            &lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{0}&lt;/span&gt;&#xA;        &lt;/td&gt;&#xA;        &lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&#xA;            &lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{1}&lt;/span&gt;&#xA;        &lt;/td&gt;&#xA;        &lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&#xA;            &lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{2}&lt;/span&gt;&#xA;        &lt;/td&gt;&#xA;        &lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&#xA;            &lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{3}&lt;/span&gt;&#xA;        &lt;/td&gt;&#xA;        &lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&#xA;            &lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{4}&lt;/span&gt;&#xA;        &lt;/td&gt;&lt;/tr&gt;&quot;, &#xA;        // 각 열의 데이터를 {0}부터 {4}까지 순서대로 삽입합니다.&#xA;        row(&quot;순위&quot;), row(&quot;공연명&quot;), row(&quot;시작일&quot;), row(&quot;종료일&quot;), row(&quot;장소&quot;)&#xA;    )&#xA;).ToArray())  // 각 행을 변환한 후 문자열 배열로 변환하고 이를 다시 하나의 문자열로 합칩니다." DisplayName="1위 DT를 문자열 변환 | Assign" sap:VirtualizedContainerService.HintSize="642,936.6666666666666" sap2010:WorkflowViewState.IdRef="Assign_9">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_topRankData]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join("", in_topRankDataTable.AsEnumerable().Select(Function(row) String.Format("&lt;tr&gt;&lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{0}&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{1}&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{2}&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{3}&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align: center; height: 29px; border: 1pt solid rgb(0, 0, 0);'&gt;&lt;span style='font-family: ''Malgun Gothic''; font-size: 12pt;'&gt;{4}&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;", row("순위"), row("공연명"), row("시작일"), row("종료일"), row("장소"))).ToArray())]</InArgument>
      </Assign.Value>
