    <Assign sap2010:Annotation.AnnotationText="(초성 인덱스 * 21 + 중성 인덱스) * 28 + 종성 인덱스 + 0xAC00&#xA;&#xA;0xAC00 =&gt; 가, 44032&#xA;&#xA;chosung = (Unicode - 44032 ) / 28 / 21&#xA;jungsung = (Unicode - 44032 ) / 28 % 21&#xA;jongsung = (Unicode - 44032 ) % 28&#xA;&#xA;[설명: AscW(strFrist): strFrist의 유니코드 값을 얻습니다.&#xA;44032: 한글 유니코드 시작 값입니다.&#xA;(AscW(strFrist) - 44032): 유니코드 값에서 한글 유니코드 시작 값을 뺍니다.&#xA;/ 28: 한글의 종성 개수로 나누어 초성과 중성을 분리합니다.&#xA;/ 21: 한글의 중성 개수로 나누어 초성을 구분합니다.&#xA;Math.Floor: 소수점을 버립니다.&#xA;CInt: 소수를 정수로 변환합니다.]" DisplayName="초성 인덱스 계산 | Assign" sap:VirtualizedContainerService.HintSize="434,396" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[intIndex]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[CInt( Math.Floor( Math.Floor( (AscW(strFrist) - 44032) / 28) / 21))]</InArgument>
      </Assign.Value>
