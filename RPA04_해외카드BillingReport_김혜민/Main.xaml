    "----------------------------" &amp; vbCrLf &amp;
    String.Join(vbCrLf, billingTable.AsEnumerable().Select(Function(row) row.Field(Of String)("ReferenceNumber") &amp; "        " &amp; row.Field(Of Double)("PaymentAmount").ToString("F2"))) &amp; vbCrLf &amp;
    "----------------------------" &amp; vbCrLf &amp;
    "Total amount:    $" &amp; totalAmount.ToString("F2") &amp; vbCrLf &amp;
    "Ref. amount:     $" &amp; refAmount.ToString("F2") &amp; vbCrLf &amp;
    If(totalAmount = refAmount, "Total amount가 일치합니다", "Total amount가 일치하지 않습니다")]</InArgument>
