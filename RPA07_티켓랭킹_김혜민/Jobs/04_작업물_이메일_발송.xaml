    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="//불러온 병합 DT의 Row 값을 반복문으로 htmlTable 변수에 할당 (데이터 행 동적 추가)" DataTable="[in_topRankDataTable]" DisplayName="메일 제목 및 본문 작성 반복문 | For Each Row in Data Table" sap:VirtualizedContainerService.HintSize="530,472.6666666666667" sap2010:WorkflowViewState.IdRef="ForEachRow_2">
