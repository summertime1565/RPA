    <Sequence sap2010:Annotation.AnnotationText="//메일 제목 및 본문 작성 시 String.Format을 사용하였음" DisplayName="메일 구성 요소 변수 선언 | Sequence" sap:VirtualizedContainerService.HintSize="530,732" sap2010:WorkflowViewState.IdRef="Sequence_9">
