    <Assign sap2010:Annotation.AnnotationText="//HTML 스타일 및 표에 작성될 Row를 추가&#xA;&#xA;&lt;style&gt;&#xA;    table {&#xA;        width: 100%; /* 테이블 너비를 100%로 설정 */&#xA;        border-collapse: collapse; /* 테이블 테두리를 하나로 합침 */&#xA;    }&#xA;    th, td {&#xA;        border: 1px solid #ddd; /* 셀에 테두리 추가 */&#xA;        padding: 8px; /* 셀 내부 여백 설정 */&#xA;    }&#xA;    th {&#xA;        background-color: #4CAF50; /* 헤더 셀의 배경색을 녹색으로 설정 */&#xA;        color: white; /* 헤더 셀의 글자색을 흰색으로 설정 */&#xA;    }&#xA;&lt;/style&gt;&#xA;&#xA;+&#xA;&#xA;테이블 추가" DisplayName="HTML 스타일 추가 | Assign" sap:VirtualizedContainerService.HintSize="530,480" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[htmlTable]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String" xml:space="preserve">&lt;style&gt;
              table {width: 100%; border-collapse: collapse;}
              th, td {border: 1px solid #ddd; padding: 8px;}
              th {background-color: #4CAF50; color: white; text-align: center;}
              td {text-align: center;}
            &lt;/style&gt;
            &lt;table style='width:100%; border-collapse: collapse;'&gt;
            &lt;thead&gt;
              &lt;tr style='background-color: #4CAF50; color: white;'&gt;
                &lt;th style='border: 1px solid #ddd; padding: 8px;'&gt;순위&lt;/th&gt;
                &lt;th style='border: 1px solid #ddd; padding: 8px;'&gt;공연명&lt;/th&gt;
                &lt;th style='border: 1px solid #ddd; padding: 8px;'&gt;시작일&lt;/th&gt;
